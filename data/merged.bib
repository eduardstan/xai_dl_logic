keywords = {Automaton-based algorithms,Complex task,Computer circuits,Deep learning,Encoding (symbols),Encodings,Job analysis,Learning Automata,Learning algorithms,Linear temporal logic,Motion planning,Motion-planning,Reinforcement learning,Reinforcement learning algorithms,Reinforcement learnings,Robot programming,Semantics,Signal encoding,Structural feature,Task analysis,Temporal logic,Transformer,motion planning,reinforcement learning},
number = {8},
pages = {4831--4838},
title = {{Exploiting Transformer in Sparse Reward Reinforcement Learning for Interpretable Temporal Logic Motion Planning}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85163542111&doi=10.1109%2FLRA.2023.3290511&partnerID=40&md5=8cfeeae9e20ff4d003b1afe83c8a3379},
volume = {8},
