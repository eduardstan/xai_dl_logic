booktitle = {Proceedings of the AAAI Conference on Artificial Intelligence},
doi = {10.1609/aaai.v39i9.32981},
keywords = {Background variation,Data-hiding,Embeddings,Extraction accuracy,Graphic format,Hyperlinks,Learn+,Online information,Physical data,Vector graphics},
number = {9},
pages = {9068--9075},
title = {{Physical Marker: Revealing Invisible Hyperlinks Hidden in Printed Trademarks}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003964168&doi=10.1609%2Faaai.v39i9.32981&partnerID=40&md5=d676a32475fa3d81ff0690916fb1900a},
volume = {39},
