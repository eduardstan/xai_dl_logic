doi = {10.1109/CVPR52688.2022.01007},
keywords = {Computer vision,Deep learning,Deep learning architecture and technique,Deep learning architectures and techniques,Explainable computer vision,Human understanding,Learn+,Learning architectures,Learning techniques,Raw images,Representation learning,Visual concept,Visual reasoning},
pages = {10307--10318},
title = {{Interactive Disentanglement: Learning Concepts by Interacting with their Prototype Representations}},
