journal = {IEEE Transactions on Fuzzy Systems},
keywords = {Benchmarking,Classification (of information),Convolutional neural network,Convolutional neural network (CNN),Distillation,Fuzzy classifiers,Fuzzy inference,Fuzzy rules,Interpretability,Iterative methods,Knowledge distillation,Label information,Learning systems,Neural networks,Soft label information,Soft labels,Takagi - sugeno - kang fuzzy classifier,Takagi-Sugeno-Kang (TSK) fuzzy classifier,Takagi-sugeno,interpretability,knowledge distillation,soft label information},
number = {6},
pages = {1843--1854},
title = {{A CNN-Based Born-Again TSK Fuzzy Classifier Integrating Soft Label Information and Knowledge Distillation}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85140720269&doi=10.1109%2FTFUZZ.2022.3215566&partnerID=40&md5=b01f4b17ab19edeb7e8aabcf9ebc0d9d},
