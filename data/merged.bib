doi = {10.1007/s00521-024-10811-0},
journal = {Neural Computing and Applications},
keywords = {Analytical approach,Decision trees,Explainability,Feature importance,Input space,Interpretability,Late work,Linear transformations,Local linear models,Neural network models,Neural networks,Neural-networks,Research focus,Trained neural networks},
number = {5},
pages = {3419--3433},
title = {{Analyzing feature importance with neural-network-derived trees}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85212147157&doi=10.1007%2Fs00521-024-10811-0&partnerID=40&md5=34a8bd8681fd53656f62ba87d70f15d3},
volume = {37},
