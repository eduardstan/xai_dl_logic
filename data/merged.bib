keywords = {Action spaces,Autonomous agents,Complex networks,Decision trees,Efficiency,Explainability,Exploration policy,Exploration techniques,Fertilizers,Learn+,Meta-training,Multi agent systems,Multi-Agent Reinforcement Learning,Multi-agent reinforcement learning,Real-world,Reinforcement learning,Sample efficiency,Space structure},
pages = {2791--2793},
title = {{Advancing Sample Efficiency and Explainability in Multi-Agent Reinforcement Learning}},
