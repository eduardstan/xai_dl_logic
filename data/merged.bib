keywords = {Auto encoders,Complexity theory,Computer circuits,Fuzzy autoencoder,Fuzzy inference,Fuzzy sets,Fuzzy-Logic,Hierarchical fuzzy systems,Hierarchical systems,Input variables,Interpretability,Learning systems,Optimisations,Regression analysis,Regression predictions,Self organized fuzzy,hierarchical fuzzy system (HFS),interpretability,regression prediction},
number = {12},
pages = {5104--5115},
title = {{A Self-Organized Method for a Hierarchical Fuzzy Logic System Based on a Fuzzy Autoencoder}},
