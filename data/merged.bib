doi = {10.1609/aaai.v35i18.17946},
keywords = {'current,ART neural networks,Chemical activation,Complex networks,Computational complexity,Flexible activation functions,Lime,Neural networks,Neural networks structure,Neural-networks,Novel neural network,Output and inputs,Saliency map,State of the art,Uncertainty},
pages = {15899--15900},
title = {{Scalable Partial Explainability in Neural Networks via Flexible Activation Functions (Student Abstract)}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85130096389&doi=10.1609%2Faaai.v35i18.17946&partnerID=40&md5=ac0b63837b04c18b3e5ecfa6b3cbf2e5},
volume = {18},
