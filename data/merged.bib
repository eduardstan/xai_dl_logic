keywords = { Computer,Article,Behavioral analysis,Behavioral research,Cognition,Decentralized policies,Imitation learning,Learning,Learning systems,Mechanical constraints,Multi agent,Multi agent systems,Multi-agent imitation learning,Neural Networks,Neural networks,Neural-networks,Observation constraints,Partial observation,Real-world,Recurrent neural networks,Sports,artificial neural network,basketball,biomechanics,cognition,decentralization,human,learning,mathematical model,prediction,recurrent neural network,simulation,soccer},
pages = {40--52},
title = {{Decentralized policy learning with partial observation and mechanical constraints for multiperson modeling}},
