title = {{MEGNN: Meta-path extracted graph neural network for heterogeneous graph representation learning}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85118138175&doi=10.1016%2Fj.knosys.2021.107611&partnerID=40&md5=422ef2820a1c09a8f918bfd2fb55941a},
