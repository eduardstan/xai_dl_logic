number = {11},
pages = {16952--16959},
title = {{Biologically Plausible Sparse Temporal Word Representations}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85164378449&doi=10.1109%2FTNNLS.2023.3290004&partnerID=40&md5=9979be8786c60551b5c8b353723ae9e8},
