booktitle = {IJCAI International Joint Conference on Artificial Intelligence},
doi = {10.24963/ijcai.2019/842},
editor = {Kraus, S},
isbn = {978-0-9992411-4-1},
number = {28th International Joint Conference on Artificial Intelligence},
pages = {6081--6087},
title = {{Learning Relational Representations with Auto-encoding Logic Programs}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85074932472&doi=10.24963%2Fijcai.2019%2F842&partnerID=40&md5=2e305d43c796236d5a6298806f28fd4a},
