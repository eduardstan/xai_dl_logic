author = {Weber, L and Minervini, P and M{\"{u}}nchmeyer, J and Leser, U and Rockt{\"{a}}schel, T},
booktitle = {ACL 2019 - 57th Annual Meeting of the Association for Computational Linguistics, Proceedings of the Conference},
keywords = {Computational linguistics,Distributed representation,Logic programming,Natural language processing systems,Natural languages,PROLOG (programming language),Question Answering,Question Answering Task,Rule based reasoning,Rule-based models,Similarity functions,Weak unifications},
pages = {6151--6161},
title = {{NLProlog: Reasoning with weak unification for question answering in natural language}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084035959&partnerID=40&md5=cb3194ee1eb6345566a7376021e49f18},
year = {2020}
