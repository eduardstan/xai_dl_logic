journal = {IEEE Transactions on Fuzzy Systems},
keywords = {Convolutional neural network,Data mining,Decision trees,Diagnosis,Distillation,Fuzzy decision trees,Hidden Markov models,Hidden-Markov models,Interpretable,Knowledge distillation,Knowledge engineering,Learn+,Neural networks,Predictive models,Respiratory sounds,Sound analysis,Speech recognition,Tree regularizations,fuzzy decision tree,interpretable,knowledge distillation,respiratory sounds},
number = {6},
pages = {1516--1528},
title = {{Explainable CNN with Fuzzy Tree Regularization for Respiratory Sound Analysis}},
