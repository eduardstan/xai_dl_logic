keywords = {Article,Attention,Attention mechanisms,Biological organs,Classification framework,Computer aided diagnosis,Computer-Aided diagnoses,Diseases,Dual path,Dual path network,Economic and social effects,False positive rates,Lung Cancer,Lung cancer,Positron emission tomography,Pulmonary nodule classification,Pulmonary nodules,Reasoning procedures,artificial neural network,automation,cancer classification,clinical effectiveness,controlled study,correlation analysis,deep learning,diagnostic accuracy,diagnostic test accuracy study,experimental study,factual database,human,image analysis,intermethod comparison,lung nodule,mathematical model,nuclear magnetic resonance imaging,prediction,priority journal,receiver operating characteristic,sensitivity and specificity,spatial analysis,x-ray computed tomography},
pages = {422--430},
title = {{Attentive and ensemble 3D dual path networks for pulmonary nodules classification}},
