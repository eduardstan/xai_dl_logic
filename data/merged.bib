keywords = {Deformable models,Latent representation,Physical simulation,Self-supervised learning},
pages = {23158--23167},
title = {{Neural Modes: Self-supervised Learning of Nonlinear Modal Subspaces}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199863976&doi=10.1109%2FCVPR52733.2024.02185&partnerID=40&md5=a4fe1c42f34002e10f02f8e06e7ef919},
