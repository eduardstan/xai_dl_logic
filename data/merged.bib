keywords = {Fine grained,Hierarchical structures,Hyperbolic spaces,Interpretability,Knowledge graph,Knowledge graphs,Personalized recommender systems,Poincare,Recommendation performance,Recommender systems,Structure of knowledge,Top-K recommendations},
pages = {4285--4293},
title = {{Knowledge-Enhanced Top-K Recommendation in Poincar{\'{e}} Ball}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85113851272&doi=10.1609%2Faaai.v35i5.16553&partnerID=40&md5=d50a82f1f2f3bf5cd56b65a9b983caa9},
volume = {5B},
