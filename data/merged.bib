editor = {Larson, K},
isbn = {978-1-956792-04-1},
keywords = {'current,End to end,First systems,Handcrafted rules,Inference engines,Interpretability,Language model,Modeling languages,PROLOG (programming language),Proof search,Proof tree,Semiparametric,State of the art},
number = {33rd International Joint Conference on Artificial Intelligence (IJCAI)},
pages = {3602--3612},
title = {{NELLIE: A Neuro-Symbolic Inference Engine for Grounded, Compositional, and Explainable Reasoning}},
