keywords = {Benchmarking,Classification,Classification (of information),Computational process,Hierarchical structure,Image recognition,Knowledge base,Knowledge based systems,Learning models,Multi-layered,Multiple levels,Prototype-based,Recognition models,Self-training,Semi-supervised classification,Semi-supervised learning,State-of-the-art performance,Supervised learning},
pages = {204--224},
title = {{A self-training hierarchical prototype-based approach for semi-supervised classification}},
