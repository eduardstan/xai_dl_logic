title = {{IT2-ENFIS: Interval Type-2 Exclusionary Neuro-Fuzzy Inference System, An Attempt Towards Trustworthy Regression Learning}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105006897459&doi=10.1109%2FTAI.2025.3574299&partnerID=40&md5=ffe6de5f21e6e85728b5246ab31f3dd9},
year = {2025}
