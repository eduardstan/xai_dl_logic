keywords = {Bayesian,Compensation (personnel),Data mining,Knowledge management,LinkedIn,Model components,Overall design,Social networking (online),Statistical modeling,Wages},
pages = {447--455},
title = {{Bringing salary transparency to theworld: Computing robust compensation insights via linkedin salary}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85037358295&doi=10.1145%2F3132847.3132863&partnerID=40&md5=c15fc6bb5264789bf25c9ddaa5446c1d},
volume = {Part F131841},
year = {2017}
