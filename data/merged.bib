number = {6},
pages = {1747--1759},
title = {{Explainable AI for domain experts: a post Hoc analysis of deep learning for defect classification of TFT–LCD panels}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85103357862&doi=10.1007%2Fs10845-021-01758-3&partnerID=40&md5=16f186275509ce2a248ef91eff6f2e10},
