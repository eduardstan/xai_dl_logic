title = {{Dynamic analysis of disease progression in Alzheimer's disease under the influence of hybrid synapse and spatially correlated noise}},
url = {https://www.embase.com/search/results?subaction=viewrecord&id=L2012927263&from=export http://dx.doi.org/10.1016/j.neucom.2021.05.067},
volume = {456},
