journal = {ADVANCED INTELLIGENT SYSTEMS},
keywords = {Adversarial machine learning,Contrastive Learning,Deep learning,Design problems,Federated learning,Functional behaviors,Functional response,Generative adversarial networks,Generative design,Interpretable machine learning,Inverse designs,Inverse problems,Machine-learning,Markov chains,On demands,Property,Random forests,Zero-shot learning,functional responses,generative design,interpretable machine learning,inverse design,metamaterials},
number = {6},
title = {{Generative Inverse Design of Metamaterials with Functional Responses by Interpretable Learning}},
