doi = {10.1016/j.artmed.2024.102916},
journal = {Artificial Intelligence in Medicine},
keywords = { Computer,Article,Backpropagation,Classification (of information),Clinical Coding,Diagnosis,Disease knowledge graph,EHR coding,Electronic Health Records,Electronic health,Electronic health record coding,Explainability,Graph propagation,Health records,Humans,Hybrid attention,ICD,Information retrieval systems,International Classification of Diseases,International classification of disease,Knowledge graph,Knowledge graphs,Medical applications,Natural Language Processing,Neural Networks,Neural-networks,acute respiratory failure,artificial neural network,attention network,child parent relation,classifier,coding,comorbidity,controlled study,coronary atherosclerosis,deep learning,dimensionality reduction,disease course,electronic health record,embedding,entropy,feature extraction,heart failure,human,hypertension,kidney failure,knowledge graph,knowledge management,long short term memory network,multilabel classification,natural language processing,procedures,rare disease},
title = {{EHR coding with hybrid attention and features propagation on disease knowledge graph}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85196652394&doi=10.1016%2Fj.artmed.2024.102916&partnerID=40&md5=8a62f2820855f817824710302744a78f},
volume = {154},
