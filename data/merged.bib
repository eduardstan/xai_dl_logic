keywords = {Binary classifiers,Binary neural networks,Binary trees,C (programming language),Decision trees,Logical representations,Multilayer neural networks,Multilayers perceptrons,Polynomial approximation,Polynomial space,Polynomial-time,Random forests,Representation languages,Space translation,Time-space,Translation (languages)},
pages = {3158--3166},
title = {{On Translations between ML Models for XAI Purposes}},
