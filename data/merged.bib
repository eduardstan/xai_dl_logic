doi = {10.1609/aaai.v39i10.33107},
keywords = {Black boxes,Complex task,Flow convergence,Information flows,Interpretability,Language model,Model complexes,Multi-modal,Rapid growth,Similarity computation},
number = {10},
pages = {10203--10211},
title = {{Enhancing Multimodal Large Language Models Complex Reason via Similarity Computation}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105004196568&doi=10.1609%2Faaai.v39i10.33107&partnerID=40&md5=bdc0353a3a8894044c17430463e463cf},
volume = {39},
