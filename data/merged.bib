booktitle = {Proceedings of the 36th AAAI Conference on Artificial Intelligence, AAAI 2022},
doi = {10.1609/aaai.v36i8.20868},
keywords = {Artificial intelligence,Behavioural cloning,Clone cells,Demonstrations,Imitation learning,Learn+,Learning problem,Length variants,Multiple stages,Robotics applications,Without fine-tuning},
pages = {8866--8873},
title = {{Stage Conscious Attention Network (SCAN): A Demonstration-Conditioned Policy for Few-Shot Imitation}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85147719171&doi=10.1609%2Faaai.v36i8.20868&partnerID=40&md5=36e0754994dc9250d21622a963d94f47},
volume = {36},
year = {2022}
