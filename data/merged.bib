doi = {10.1609/aaai.v39i11.33225},
keywords = {Cardinalities,Cardinality constraints,Digital arithmetic,Heuristic methods,Hyper-parameter,Index tracking,Investment strategy,NP-hard,Neural-networks,Non-differentiable,Optimization,Partial replication,Transaction cost},
number = {11},
pages = {11264--11271},
title = {{DCC: Differentiable Cardinality Constraints for Partial Index Tracking}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003904802&doi=10.1609%2Faaai.v39i11.33225&partnerID=40&md5=e5f3320a9d0f968045fb2e915471aad3},
volume = {39},
