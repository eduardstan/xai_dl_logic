journal = {IEEE Transactions on Fuzzy Systems},
keywords = {Brain modeling,Computer circuits,Convolution,Convolutional networks,Deep learning,Fuzzy inference,Fuzzy logic,Fuzzy neural networks,Fuzzy representations,Fuzzy sets,Fuzzy-Logic,Graph convolutional network,Graph representation,Graph theory,Hierarchical systems,Representation learning,Uncertainty,Uncertainty analysis,fuzzy representation,graph convolutional network,graph representation},
number = {10},
pages = {3358--3370},
title = {{Fuzzy Representation Learning on Graph}},
