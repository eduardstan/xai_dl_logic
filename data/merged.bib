keywords = {Artificial intelligence,Decision trees,Explainable Artificial Intelligence,Explainable artificial intelligence,Language model,Large Language Models,Large language model,Learning systems,Learning to Rank,Model-based OPC,Rank modeling,State-of-the-art methods,Tabular data,Text Ranking,Text rankings,Textual data,Traditional learning},
pages = {5185--5188},
title = {{Explaining Learning to Rank Methods to Improve Them}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85178099710&doi=10.1145%2F3583780.3616002&partnerID=40&md5=17b83e965a35571d47ab6dae689c697e},
year = {2023}
