keywords = { Computer,Algorithms,CTL specification,Computational tree logic,Computational tree logic specification,Computer Simulation,Data-driven model,Data-driven modeling,Humans,Interpretability,Logic,Logic specifications,Model abstraction,Model verification,Neural Networks,Neural network model,Neural network models,Reachability analysis,Transition system,adult,algorithm,article,artificial neural network,computer simulation,controlled study,human,logic,nerve cell,nerve cell network,tree},
