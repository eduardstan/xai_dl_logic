journal = {Machine Learning and Knowledge Extraction},
keywords = {Shapley values,Theory of Mind,artificial neural networks (ANNs),explainable artificial intelligence (xAI),functional magnetic resonance imaging (fMRI),human connectome project (HCP),path-weights,shallow neural networks (SNNs),social cognition},
