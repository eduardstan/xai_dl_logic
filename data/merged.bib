keywords = {Bridge decks,Convolution,Convolutional neural network,Convolutional neural networks,Decision making,Deep learning,Expert knowledge,Explainable deep learning,Image enhancement,Image recognition,Learning process,Learning systems,Network-based,Non destructive testing,Non-destructive testing,Nondestructive examination,Radiographic images,Self-supervised learning,Small Sample Size,Welding,Welding radiographic image,Welds},
title = {{An expert knowledge-empowered CNN approach for welding radiographic image recognition}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85152603874&doi=10.1016%2Fj.aei.2023.101963&partnerID=40&md5=cc08c704843d3cdb2a79a2a37460730c},
volume = {56},
