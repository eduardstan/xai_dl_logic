editor = {Ferrari, V and Hebert, M and Sminchisescu, C and Weiss, Y},
isbn = {0302-9743},
keywords = {Classification tasks,Computer vision,Convolutional neural network,Grad-CAM,Interpretability,Learning approach,Learning classifiers,Natural languages,Network parameters,Neural networks,Neurons,Semantics,Zero Shot Learning},
