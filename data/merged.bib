doi = {10.18653/v1/e17-1009},
isbn = {978-1-945626-34-0},
keywords = {Computational linguistics,Embeddings,Feature representation,Human-readable,Interpretability,State of the art,Word sense,Word sense inductions,Yield state},
number = {15th Conference of the European-Chapter of the Association-for-Computational-Linguistics (EACL)},
pages = {86--98},
title = {{Unsupervised Does Not Mean Uninterpretable: The Case forWord Sense Induction and Disambiguation}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85021654693&doi=10.18653%2Fv1%2Fe17-1009&partnerID=40&md5=6f6d3914b558237764307a759a414ed4},
volume = {1},
