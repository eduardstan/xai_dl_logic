number = {4},
pages = {1915--1926},
title = {{ARTxAI: Explainable Artificial Intelligence Curates Deep Representation Learning for Artistic Images Using Fuzzy Techniques}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184832045&doi=10.1109%2FTFUZZ.2023.3337878&partnerID=40&md5=30658067098893effcda7648948667e9},
