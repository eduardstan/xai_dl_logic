title = {{FIT-graph: A multi-grained evolutionary graph based framework for disease diagnosis}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85180369001&doi=10.1016%2Fj.artmed.2023.102735&partnerID=40&md5=2c4f56bc87a028118da9f8e65c79b334},
