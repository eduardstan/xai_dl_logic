keywords = {Algorithms,Artificial Intelligence,Artificial agents,Behavioral research,Child,Cognitive model,Cognitive modeling,Data mining,Developmental robotics,Explainable AI,Extraction,Female,Humans,Implicit knowledge,Knowledge,Knowledge extraction,Knowledge representation,Learning algorithms,Learning systems,Machine Learning,Post-hoc rule extraction,Problem Solving,Q learning,Recurrent neural networks,Reinforcement learning,Reinforcement learnings,Robotics,Rules extraction,Towers of Hanoi,algorithm,article,artificial intelligence,child,extraction,female,finite state machine,human,human experiment,knowledge,learning,machine learning,male,problem solving,recurrent neural network,reinforcement (psychology),robotics},
