doi = {10.1109/ICRA40945.2020.9197267},
keywords = {Admittance control,Agricultural robots,Augmented reality,Bilateral teleoperation,Bilateral teleoperation controls,Haptic feedbacks,Haptic manipulators,Kinematic constraints,Kinematics,Layered approaches,Manipulators,Remote center of motions,Remote control,Robot applications,Robotics,Robots},
pages = {4477--4482},
title = {{Bilateral Teleoperation Control of a Redundant Manipulator with an RCM Kinematic Constraint}},
