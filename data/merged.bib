doi = {10.1016/j.patcog.2021.107825},
journal = {Pattern Recognition},
keywords = {Classification models,Computer aided diagnosis,Computer-aided diagnoses,Convolutional block attention module,Convolutional neural network,Deep learning,Economic and social effects,Empirical studies,Inference stages,Learning techniques,Network architecture,Neural architecture search,Neural architectures,Prediction accuracy,Pulmonary nodule classification,Pulmonary nodules,Reasoning process},
title = {{Learning efficient, explainable and discriminative representations for pulmonary nodules classification}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100008806&doi=10.1016%2Fj.patcog.2021.107825&partnerID=40&md5=7f67a74080c536cb7b7ed98194f26571},
