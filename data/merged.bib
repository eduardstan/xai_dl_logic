number = {1},
pages = {1--27},
title = {{Exploratory factor analysis with structured residuals for brain network data}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85101136421&doi=10.1162%2Fnetn_a_00162&partnerID=40&md5=fd58b00b5268b5cdd0b7b6f102928325},
